NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conta dedicada aos testes E2E. Nunca reutilize credenciais pessoais.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_PERFUME_ID=

# Server-only: nunca use NEXT_PUBLIC_ nestas variáveis.
TAVILY_API_KEY=
OPENAI_API_KEY=
SUPABASE_SECRET_KEY=
PERFUME_AUTOFILL_ENABLED=false
NEXT_PUBLIC_PERFUME_AUTOFILL_VISIBLE=false
PERFUME_AUTOFILL_MODEL=gpt-5.6-terra
PERFUME_AUTOFILL_CACHE_TTL_SECONDS=604800
PERFUME_AUTOFILL_RATE_LIMIT_MAX=10
PERFUME_AUTOFILL_RATE_LIMIT_WINDOW_SECONDS=3600
PERFUME_AUTOFILL_PROVIDER_TIMEOUT_MS=8000
PERFUME_AUTOFILL_REQUEST_TIMEOUT_MS=25000
PERFUME_AUTOFILL_MAX_RESULTS=6
PERFUME_AUTOFILL_MAX_CONTENT_CHARS=4000
